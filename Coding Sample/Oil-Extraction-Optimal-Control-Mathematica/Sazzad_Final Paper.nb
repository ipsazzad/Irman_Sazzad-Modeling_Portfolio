Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Functions", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Cst", "[", "u_", "]"}], ":=", 
     RowBox[{"0.5", "*", 
      RowBox[{"u", "^", "2"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Prc", "[", "u_", "]"}], ":=", 
     RowBox[{"a", "-", 
      RowBox[{"b", "*", "u"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"H", "[", 
      RowBox[{"u_", ",", "\[Mu]_", ",", "t_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", "-", 
         RowBox[{"b", "*", "u"}]}], ")"}], "*", "u"}], "-", 
      RowBox[{"0.5", "*", 
       RowBox[{"u", "^", "2"}]}], "-", 
      RowBox[{"\[Mu]", "*", "u"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"dHdu", "[", 
      RowBox[{"u_", ",", "\[Mu]_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"H", "[", 
        RowBox[{"u", ",", "\[Mu]", ",", "t"}], "]"}], ",", "u"}], "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"u", "[", 
      RowBox[{"T_", ",", "r_", ",", "t_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", "*", "b"}], "+", "1"}], ")"}]}], "*", 
      RowBox[{"(", 
       RowBox[{"a", "-", 
        RowBox[{"S", "*", 
         RowBox[{"Exp", "[", 
          RowBox[{"r", "*", 
           RowBox[{"(", 
            RowBox[{"t", "-", "T"}], ")"}]}], "]"}]}]}], ")"}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"\[Mu]", "[", 
      RowBox[{"T_", ",", "r_", ",", "t_"}], "]"}], ":=", 
     RowBox[{"S", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{"r", "*", 
        RowBox[{"(", 
         RowBox[{"t", "-", "T"}], ")"}]}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Y", " ", "as", " ", "the", " ", "integral", " ", "of", " ", "u"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Y", "[", 
     RowBox[{"T_", ",", "r_"}], "]"}], ":=", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"u", "[", 
       RowBox[{"T", ",", "r", ",", "\[Tau]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Tau]", ",", "0", ",", "T"}], "}"}]}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"solving", " ", "x", 
     RowBox[{"(", "t", ")"}], " ", "analytically"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"x", "[", 
     RowBox[{"T_", ",", "r_"}], "]"}], ":=", 
    RowBox[{"-", 
     RowBox[{"Integrate", "[", 
      RowBox[{
       RowBox[{"u", "[", 
        RowBox[{"T", ",", "r", ",", "\[Tau]"}], "]"}], ",", 
       RowBox[{"{", 
