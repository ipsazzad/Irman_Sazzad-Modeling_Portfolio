Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ode1", "[", 
    RowBox[{"xb0_", ",", "hb0_"}], "]"}], ":=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"xb", "'"}], "[", "t", "]"}], "==", 
        RowBox[{
         RowBox[{"xx", "'"}], "[", "t", "]"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"hb", "'"}], "[", "t", "]"}], "\[Equal]", 
        RowBox[{
         RowBox[{"hh", "'"}], "[", "t", "]"}]}], ",", 
       RowBox[{
        RowBox[{"xb", "[", "0", "]"}], "\[Equal]", "xb0"}], ",", 
       RowBox[{
        RowBox[{"hb", "[", "0", "]"}], "\[Equal]", "hb0"}]}], "}"}], ",", 
     RowBox[{"{", 
